# ── Geral ──────────────────────────────────────────────────────────────────────
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-only-change-in-production

# Dev: True | Produção: False
DEBUG=True

# Produção: seu domínio + www (ex.: "solve.app,www.solve.app")
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Banco de dados ─────────────────────────────────────────────────────────────
# Local SQLite: deixe comentado → usa SQLite automaticamente
# Local Docker Compose (Postgres): descomente a linha abaixo
# DATABASE_URL=postgresql://solve:solve@db:5432/solve
# Produção (Railway injeta automaticamente; Render: copie do painel):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth Google (OAuth 2.0) ────────────────────────────────────────────────────
# 1. Acesse: https://console.cloud.google.com/apis/credentials
# 2. Crie um projeto → "OAuth 2.0 Client IDs" → tipo "Web application"
# 3. Dev — Authorized redirect URIs: http://localhost:8000/accounts/google/login/callback/
# 4. Prod — Authorized redirect URIs: https://seudominio.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── E-mail transacional ────────────────────────────────────────────────────────
# Dev: imprime no terminal (padrão, sem configuração necessária)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Produção com Resend (recomendado — grátis até 3.000 e-mails/mês):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxx   ← API key do Resend
# DEFAULT_FROM_EMAIL=Solve <noreply@seudominio.com>

# ── Verificação de e-mail allauth ──────────────────────────────────────────────
# "none"      → sem verificação (dev local)
# "optional"  → envia e-mail mas não bloqueia acesso
# "mandatory" → bloqueia até confirmar (produção recomendado)
ACCOUNT_EMAIL_VERIFICATION=none
