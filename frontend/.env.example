# ── Geral ─────────────────────────────────────────────────────────────────────
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-only-change-in-production

DEBUG=True

# Produção: seu domínio + www (ex.: "solve.app,www.solve.app")
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Banco de dados ─────────────────────────────────────────────────────────────
# Local: deixe comentado → usa SQLite automaticamente
# Produção (Railway/Render/Supabase): descomente e preencha
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth Google (OAuth 2.0) ────────────────────────────────────────────────────
# 1. Acesse: https://console.cloud.google.com/apis/credentials
# 2. Crie um projeto → "OAuth 2.0 Client IDs" → tipo "Web application"
# 3. Authorized redirect URIs: http://localhost:8000/accounts/google/login/callback/
# 4. Em produção: https://seudominio.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── E-mail ─────────────────────────────────────────────────────────────────────
# Dev: imprime no terminal (padrão, não precisa configurar)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Produção (ex.: SendGrid, Resend, AWS SES):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=sua-api-key
# DEFAULT_FROM_EMAIL=Solve <noreply@solve.app>

# ── Verificação de e-mail allauth ──────────────────────────────────────────────
# "none" → sem verificação (dev)
# "optional" → envia e-mail mas não bloqueia acesso
# "mandatory" → bloqueia acesso até confirmar e-mail (produção recomendado)
ACCOUNT_EMAIL_VERIFICATION=none
